# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# Never commit .env.local. It holds your passwords.

# --- Required ---------------------------------------------------------------

# Your Neon Postgres database (https://neon.tech, free tier is enough).
# In the Neon dashboard: Connect -> copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional but recommended: the direct (non-pooled) connection, used for migrations.
# Same string without "-pooler" in the host. If left out, DATABASE_URL is used.
DATABASE_URL_UNPOOLED=""

# A long random string used to sign sign-in sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Email address(es) that become the super admin when they sign up.
# Put YOUR email here. Separate several with commas.
SUPER_ADMIN_EMAILS="you@example.com"

# --- Optional ---------------------------------------------------------------

# Gmail account that sends sign-up codes, password resets, receipts and payslips.
# Needs a Gmail app password: https://myaccount.google.com/apppasswords
# If left empty while running `npm run dev`, codes are printed in the terminal instead.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Time zone for shift and order times. Defaults to the device's time zone.
NEXT_PUBLIC_TIMEZONE="Asia/Manila"
